# Copy to backend/.env and fill in. docker-compose reads this file and then
# overrides DATABASE_URL, DEBUG and USE_S3 with values that point at the local
# stack, so a .env aimed at Railway cannot reach production by accident.

# --- Required: Django refuses to start without these ---------------------
SECRET_KEY=
# Set by docker-compose for local work; needed only when running Django directly.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
OPENAI_API_KEY=

# --- Optional: shown with their defaults ---------------------------------
DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins. Leave empty in local development, where DEBUG=True
# already allows every origin.
# CORS_ALLOWED_ORIGINS=
# CSRF_TRUSTED_ORIGINS=

# Media goes to S3-compatible object storage unless this is off. Defaults to
# the inverse of DEBUG.
USE_S3=False

# --- Vex -------------------------------------------------------------------
# The OpenAI model and its reasoning effort (none, minimal, low, medium, high,
# xhigh, max). gpt-6.1-sol is the bigger option; it does not take "none".
# A model needs a price in VEX_PRICES (settings.py) for its calls to be costed.
# VEX_MODEL=gpt-6-luna
# VEX_REASONING_EFFORT=low
# The cap on one answer, reasoning included.
# VEX_MAX_OUTPUT_TOKENS=1200
# The site's origin, from which Vex fetches /vex-kb/<pl|en>.json. Defaults to
# http://localhost:8080 (the Vite dev server) with DEBUG, otherwise empty,
# which leaves Vex answering from the database alone (and logs an error at
# every rebuild of its knowledge when DEBUG is off).
# VEX_SITE_CONTENT_URL=
# What Vex may spend on the model per UTC day, in dollars; once reached it
# rests until midnight UTC and offers the contact email instead.
# VEX_DAILY_BUDGET_USD=5.00
# Redis for Vex's rate limits and the day's spend, shared by every worker.
# Without it they live in each process's memory. On Railway:
# REDIS_URL=${{Redis.REDIS_URL}}. Keys are prefixed "portfolio:".
# REDIS_URL=
# The Redis database Vex keeps to, when REDIS_URL names none.
# VEX_REDIS_DB=5
# The address Vex suggests when it does not know.
# VEX_CONTACT_EMAIL=dawidhanrahan@gmail.com

# --- Object storage: required only when USE_S3=True ----------------------
# BUCKET_ENDPOINT=
# BUCKET_ACCESS_KEY_ID=
# BUCKET_SECRET_ACCESS_KEY=
# BUCKET_NAME=
# BUCKET_REGION=auto
# BUCKET_URL_EXPIRE=3600
